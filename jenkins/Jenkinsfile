pipeline {
    agent {
        label 'docker'
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 45, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'DEPLOY_TO_MINIKUBE',
            defaultValue: false,
            description: 'Load images into Minikube and deploy the Helm chart'
        )

        string(
            name: 'MINIKUBE_PROFILE',
            defaultValue: 'minikube',
            description: 'Minikube profile used for optional deployment'
        )
    }

    environment {
        MAVEN_IMAGE  = 'maven:3.9.9-eclipse-temurin-21'
        NODE_IMAGE   = 'node:22-alpine'
        KUBECTL_IMAGE = 'registry.k8s.io/kubectl:v1.36.1'
        HELM_IMAGE   = 'alpine/helm:4.2.3'
        TRIVY_IMAGE  = 'aquasec/trivy:0.70.0'

        IMAGE_TAG = "${BUILD_NUMBER}"

        USER_IMAGE         = "cloudcart-user-service"
        PRODUCT_IMAGE      = "cloudcart-product-service"
        ORDER_IMAGE        = "cloudcart-order-service"
        PAYMENT_IMAGE      = "cloudcart-payment-service"
        NOTIFICATION_IMAGE = "cloudcart-notification-service"
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm

                sh '''
                    echo "Branch: ${BRANCH_NAME:-unknown}"
                    echo "Commit: $(git rev-parse HEAD)"
                    git status --short
                '''
            }
        }

        stage('Repository Validation') {
            steps {
                sh '''
                    set -eu

                    required_files="
                    services/user-service/pom.xml
                    services/product-service/pom.xml
                    services/order-service/pom.xml
                    services/payment-service/package-lock.json
                    services/notification-service/package-lock.json
                    helm/cloudcart/Chart.yaml
                    helm/cloudcart/values.yaml
                    k8s/overlays/dev/kustomization.yaml
                    "

                    for file in $required_files; do
                        if [ ! -f "$file" ]; then
                            echo "Required file is missing: $file"
                            exit 1
                        fi
                    done

                    echo "Repository structure is valid."
                '''
            }
        }

        stage('Service Tests') {
            parallel {
                stage('Java Tests') {
                    steps {
                        sh '''
                            set -eu
                            mkdir -p .m2

                            for service in user-service product-service order-service; do
                                echo "========================================"
                                echo "Testing $service"
                                echo "========================================"

                                docker run --rm \
                                  --volumes-from jenkins-cloudcart \
                                  -v cloudcart-maven-cache:/root/.m2 \
                                  -w "$WORKSPACE/services/$service" \
                                  "$MAVEN_IMAGE" \
                                  mvn -B clean test
                            done
                        '''
                    }
                }

                stage('Node Tests') {
                    steps {
                        sh '''
                            set -eu

                            for service in payment-service notification-service; do
                                echo "========================================"
                                echo "Testing $service"
                                echo "========================================"

                                docker run --rm \
                                  --volumes-from jenkins-cloudcart \
                                  -w "$WORKSPACE/services/$service" \
                                  "$NODE_IMAGE" \
                                  sh -c "npm ci && npm test"
                            done
                        '''
                    }
                }
            }
        }

        stage('Kubernetes Validation') {
            steps {
                sh '''
                    set -eu

                    docker run --rm \
                      --volumes-from jenkins-cloudcart \
                      -w "$WORKSPACE" \
                      "$KUBECTL_IMAGE" \
                      kustomize k8s/overlays/dev \
                      > kustomize-rendered.yaml

                    test -s kustomize-rendered.yaml

                    echo "Kustomize resources:"
                    grep '^kind:' kustomize-rendered.yaml | sort | uniq -c
                '''
            }
        }

        stage('Helm Validation') {
            steps {
                sh '''
                    set -eu

                    docker run --rm \
                      --volumes-from jenkins-cloudcart \
                      -w "$WORKSPACE" \
                      "$HELM_IMAGE" \
                      lint helm/cloudcart

                    docker run --rm \
                      --volumes-from jenkins-cloudcart \
                      -w "$WORKSPACE" \
                      "$HELM_IMAGE" \
                      template cloudcart helm/cloudcart \
                        --namespace cloudcart \
                      > helm-rendered.yaml

                    test -s helm-rendered.yaml

                    echo "Helm resources:"
                    grep '^kind:' helm-rendered.yaml | sort | uniq -c
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      --pull \
                      -t "$USER_IMAGE:$IMAGE_TAG" \
                      services/user-service

                    docker build \
                      --pull \
                      -t "$PRODUCT_IMAGE:$IMAGE_TAG" \
                      services/product-service

                    docker build \
                      --pull \
                      -t "$ORDER_IMAGE:$IMAGE_TAG" \
                      services/order-service

                    docker build \
                      --pull \
                      -t "$PAYMENT_IMAGE:$IMAGE_TAG" \
                      services/payment-service

                    docker build \
                      --pull \
                      -t "$NOTIFICATION_IMAGE:$IMAGE_TAG" \
                      services/notification-service
                '''
            }
        }

        stage('Trivy Security Scans') {
            steps {
                sh '''
                    set -eu
                    mkdir -p .trivy-cache

                    for image in \
                      "$USER_IMAGE:$IMAGE_TAG" \
                      "$PRODUCT_IMAGE:$IMAGE_TAG" \
                      "$ORDER_IMAGE:$IMAGE_TAG" \
                      "$PAYMENT_IMAGE:$IMAGE_TAG" \
                      "$NOTIFICATION_IMAGE:$IMAGE_TAG"
                    do
                        echo "========================================"
                        echo "Scanning $image"
                        echo "========================================"

                        docker run --rm \
                          -v /var/run/docker.sock:/var/run/docker.sock \
                          -v cloudcart-trivy-cache:/root/.cache/ \
                          "$TRIVY_IMAGE" \
                          image \
                          --exit-code 1 \
                          --ignore-unfixed \
                          --severity HIGH,CRITICAL \
                          --scanners vuln \
                          "$image"
                    done
                '''
            }
        }

        stage('Deploy to Minikube') {
            when {
                expression {
                    return params.DEPLOY_TO_MINIKUBE
                }
            }

            steps {
                withCredentials([
                    file(
                        credentialsId: 'minikube-kubeconfig',
                        variable: 'MINIKUBE_KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        kubectl_cmd() {
                            docker run --rm \
                              --network "$MINIKUBE_PROFILE" \
                              --volumes-from jenkins-cloudcart \
                              -w "$WORKSPACE" \
                              "$KUBECTL_IMAGE" \
                              --kubeconfig "$MINIKUBE_KUBECONFIG" \
                              "$@"
                        }

                        helm_cmd() {
                            docker run --rm \
                              --network "$MINIKUBE_PROFILE" \
                              --volumes-from jenkins-cloudcart \
                              -w "$WORKSPACE" \
                              "$HELM_IMAGE" \
                              --kubeconfig "$MINIKUBE_KUBECONFIG" \
                              "$@"
                        }

                        echo "========================================"
                        echo "Checking Minikube container"
                        echo "========================================"

                        test "$(docker inspect \
                          --format='{{.State.Running}}' \
                          "$MINIKUBE_PROFILE")" = "true"

                        kubectl_cmd get nodes -o wide

                        echo "========================================"
                        echo "Loading application images"
                        echo "========================================"

                        for image in \
                          "$USER_IMAGE:$IMAGE_TAG" \
                          "$PRODUCT_IMAGE:$IMAGE_TAG" \
                          "$ORDER_IMAGE:$IMAGE_TAG" \
                          "$PAYMENT_IMAGE:$IMAGE_TAG" \
                          "$NOTIFICATION_IMAGE:$IMAGE_TAG"
                        do
                            echo "Loading $image into Minikube"

                            docker save "$image" |
                              docker exec -i \
                                "$MINIKUBE_PROFILE" \
                                docker load

                            docker exec \
                              "$MINIKUBE_PROFILE" \
                              docker image inspect \
                              "$image" >/dev/null
                        done

                        kubectl_cmd get namespace cloudcart >/dev/null 2>&1 ||
                          kubectl_cmd create namespace cloudcart

                        echo "========================================"
                        echo "Checking required Kubernetes secrets"
                        echo "========================================"

                        for secret in \
                          user-db-secret \
                          user-service-secret \
                          product-db-secret \
                          product-service-secret \
                          order-db-secret \
                          order-service-secret
                        do
                            echo "Checking secret: $secret"

                            kubectl_cmd get secret \
                              "$secret" \
                              --namespace cloudcart \
                              >/dev/null
                        done
                                                echo "========================================"
                        echo "Checking Helm migration state"
                        echo "========================================"

                        if ! helm_cmd status cloudcart \
                          --namespace cloudcart \
                          >/dev/null 2>&1
                        then
                            echo "No existing Helm release found."
                            echo "Removing Kustomize-managed resources before first Helm installation."

                            kubectl_cmd delete deployments \
                              user-service \
                              product-service \
                              order-service \
                              payment-service \
                              notification-service \
                              --namespace cloudcart \
                              --ignore-not-found=true \
                              --wait=true

                            kubectl_cmd delete statefulsets \
                              user-db \
                              product-db \
                              order-db \
                              --namespace cloudcart \
                              --ignore-not-found=true \
                              --wait=true

                            kubectl_cmd delete services \
                              user-db \
                              product-db \
                              order-db \
                              user-service \
                              product-service \
                              order-service \
                              payment-service \
                              notification-service \
                              --namespace cloudcart \
                              --ignore-not-found=true \
                              --wait=true

                            kubectl_cmd delete configmaps \
                              user-service-config \
                              product-service-config \
                              order-service-config \
                              payment-service-config \
                              notification-service-config \
                              --namespace cloudcart \
                              --ignore-not-found=true \
                              --wait=true

                            kubectl_cmd delete ingress \
                              cloudcart-ingress \
                              --namespace cloudcart \
                              --ignore-not-found=true \
                              --wait=true

                            echo "Preserved Kubernetes secrets and persistent volume claims:"

                            kubectl_cmd get secrets,pvc \
                              --namespace cloudcart
                        else
                            echo "Existing Helm release found. Migration cleanup is not required."
                        fi

                        echo "========================================"
                        echo "Deploying CloudCart with Helm"
                        echo "========================================"

                        helm_cmd upgrade --install \
                          cloudcart \
                          helm/cloudcart \
                          --namespace cloudcart \
                          --create-namespace \
                          --set-string applications.user-service.image.tag="$IMAGE_TAG" \
                          --set-string applications.product-service.image.tag="$IMAGE_TAG" \
                          --set-string applications.order-service.image.tag="$IMAGE_TAG" \
                          --set-string applications.payment-service.image.tag="$IMAGE_TAG" \
                          --set-string applications.notification-service.image.tag="$IMAGE_TAG" \
                          --rollback-on-failure \
                          --wait \
                          --timeout 10m
                    '''
                }
            }
        }

        stage('Deployment Verification') {
            when {
                expression {
                    return params.DEPLOY_TO_MINIKUBE
                }
            }

            steps {
                withCredentials([
                    file(
                        credentialsId: 'minikube-kubeconfig',
                        variable: 'MINIKUBE_KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        kubectl_cmd() {
                            docker run --rm \
                              --network "$MINIKUBE_PROFILE" \
                              --volumes-from jenkins-cloudcart \
                              -w "$WORKSPACE" \
                              "$KUBECTL_IMAGE" \
                              --kubeconfig "$MINIKUBE_KUBECONFIG" \
                              "$@"
                        }

                        echo "========================================"
                        echo "Waiting for all CloudCart pods"
                        echo "========================================"

                        kubectl_cmd wait \
                          --for=condition=Ready \
                          pod \
                          --all \
                          --namespace cloudcart \
                          --timeout=300s

                        for deployment in \
                          user-service \
                          product-service \
                          order-service \
                          payment-service \
                          notification-service
                        do
                            kubectl_cmd rollout status \
                              "deployment/$deployment" \
                              --namespace cloudcart \
                              --timeout=180s
                        done

                        echo "========================================"
                        echo "CloudCart deployment state"
                        echo "========================================"

                        kubectl_cmd get \
                          pods,services,statefulsets,ingress,pvc \
                          --namespace cloudcart \
                          -o wide

                        echo "========================================"
                        echo "Deployed application images"
                        echo "========================================"

                        kubectl_cmd get deployments \
                          --namespace cloudcart \
                          -o custom-columns='DEPLOYMENT:.metadata.name,IMAGE:.spec.template.spec.containers[*].image'
                    '''
                }
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'services/*/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts: 'helm-rendered.yaml,kustomize-rendered.yaml',
                allowEmptyArchive: true
            )

            sh '''
                rm -f helm-rendered.yaml kustomize-rendered.yaml
            '''

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {
            echo 'CloudCart Jenkins pipeline completed successfully.'
        }

        failure {
            echo 'CloudCart Jenkins pipeline failed. Review the failed stage logs.'
        }
    }
}
